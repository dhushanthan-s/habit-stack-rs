import { Theme } from "theme.slint";
import { GraphWeek, GraphDay } from "types.slint";

// The contribution grid. Geometry is computed explicitly rather than via a
// layout: the cell size is derived from the available width so the grid always
// fills its card edge to edge and never needs to scroll.
export component ContributionGraph inherits Rectangle {
    in property <[GraphWeek]> weeks;
    in property <color> tint;
    /// Seven gutter captions, supplied by Rust so week-start stays one setting.
    in property <[string]> weekday_labels;

    property <int> week_count: max(root.weeks.length, 1);
    property <length> gap: 3px;
    property <length> label_col: 24px;
    property <length> month_row: 15px;
    property <length> cell:
        (root.width - root.label_col - root.gap * (root.week_count - 1)) / root.week_count;

    height: root.month_row + root.cell * 7 + root.gap * 6;

    // Month captions. Each sits in a one-column slot but is allowed to overflow
    // it, since Rectangle does not clip its children.
    for week[wi] in root.weeks : Rectangle {
        x: root.label_col + wi * (root.cell + root.gap);
        y: 0;
        width: root.cell;
        height: root.month_row;

        Text {
            x: 0;
            y: 0;
            width: 44px;
            height: root.month_row;
            text: week.month_label;
            font-size: Theme.fs_caption;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: Theme.text_faint;
            vertical-alignment: center;
        }
    }

    // Weekday gutter, labelled on alternating rows only.
    for label[di] in root.weekday_labels : Text {
        x: 0;
        y: root.month_row + di * (root.cell + root.gap);
        width: root.label_col - 5px;
        height: root.cell;
        text: label;
        font-size: Theme.fs_caption;
        color: Theme.text_faint;
        vertical-alignment: center;
    }

    // Cells.
    for week[wi] in root.weeks : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        for day[di] in week.days : Rectangle {
            x: root.label_col + wi * (root.cell + root.gap);
            y: root.month_row + di * (root.cell + root.gap);
            width: root.cell;
            height: root.cell;
            border-radius: Theme.r_sm;
            background: day.done
                ? root.tint
                : (day.skipped ? Theme.grid_skipped : Theme.grid_empty);
            opacity: day.is_future ? 0.3 : 1.0;
            border-width: day.is_today ? 1.5px : 0px;
            border-color: Theme.text_muted;
            animate background {
                duration: Theme.quick;
                easing: ease-out;
            }

            if day.has_note : Rectangle {
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                x: parent.width - 6px;
                y: 3px;
                background: Theme.bg;
                opacity: 0.75;
            }
        }
    }
}

export component GraphKey inherits HorizontalLayout {
    in property <color> tint;
    spacing: Theme.sp_3;
    alignment: end;

    for label[i] in [ "Missed", "Skipped", "Done" ] : HorizontalLayout {
        spacing: 5px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 3px;
                background: i == 0
                    ? Theme.grid_empty
                    : (i == 1 ? Theme.grid_skipped : root.tint);
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: label;
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
            }
        }
    }
}
