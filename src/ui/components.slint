import { Theme } from "theme.slint";
import { HabitItem } from "types.slint";

// ---------------------------------------------------------------- primitives

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r_lg;
    border-width: 1px;
    border-color: Theme.border;
}

export component SectionLabel inherits Text {
    font-size: Theme.fs_caption;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: Theme.text_faint;
}

// A colour dot, vertically centred inside whatever row holds it.
export component Dot inherits VerticalLayout {
    in property <color> tint;
    in property <length> diameter: 9px;
    alignment: center;
    Rectangle {
        width: root.diameter;
        height: root.diameter;
        border-radius: root.diameter / 2;
        background: root.tint;
    }
}

export component StatBlock inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    in property <color> tint: Theme.text;
    spacing: 2px;

    Text {
        text: root.value;
        font-size: Theme.fs_display;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
    }
    Text {
        text: root.caption;
        font-size: Theme.fs_caption;
        font-weight: 500;
        letter-spacing: 0.6px;
        color: Theme.text_faint;
        horizontal-alignment: center;
    }
}

// -------------------------------------------------------------------- inputs

export component CheckButton inherits Rectangle {
    in property <bool> checked;
    in property <color> tint;
    callback clicked();

    width: 44px;
    height: 44px;

    box := Rectangle {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        background: root.checked ? root.tint : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: touch.pressed ? Theme.text_muted : Theme.border;
        animate background, border-width, border-color {
            duration: Theme.quick;
            easing: ease-out;
        }

        if root.checked : Path {
            x: 5px;
            y: 5px;
            width: 14px;
            height: 14px;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: "M 2 7.4 L 5.4 11 L 12 3.6";
            stroke: #09090B;
            stroke-width: 2px;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback accepted();

    height: 44px;
    // A TextInput narrower than 1px cannot take focus.
    min-width: 1px;
    border-radius: Theme.r_md;
    background: Theme.surface_alt;
    border-width: 1px;
    border-color: input.has-focus ? Theme.text_faint : Theme.border;
    // So tapping the padding, not just the glyphs, focuses the field.
    forward-focus: input;
    animate border-color {
        duration: Theme.quick;
        easing: ease-out;
    }

    input := TextInput {
        x: Theme.sp_3;
        y: 0;
        width: root.width - Theme.sp_3 * 2;
        height: root.height;
        font-size: Theme.fs_body;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.accepted();
        }
    }

    if input.text == "" && input.preedit-text == "" : Text {
        x: Theme.sp_3;
        y: 0;
        width: root.width - Theme.sp_3 * 2;
        height: root.height;
        text: root.placeholder;
        font-size: Theme.fs_body;
        color: Theme.text_faint;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.text;
    callback clicked();

    height: 44px;
    border-radius: Theme.r_md;
    background: touch.pressed ? Theme.surface_alt : transparent;
    animate background {
        duration: Theme.quick;
        easing: ease-out;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Theme.sp_2;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: Theme.fs_label;
                font-weight: 600;
                color: root.tint;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ColorSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text;

    Rectangle {
        width: root.selected ? 20px : 26px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.swatch;
        animate width {
            duration: Theme.quick;
            easing: ease-out;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    in property <bool> selected;
    in property <bool> show_dot: true;
    callback clicked();

    height: 34px;
    border-radius: Theme.r_full;
    background: root.selected ? root.tint.with_alpha(0.16) : Theme.surface_alt;
    border-width: 1px;
    border-color: root.selected ? root.tint.with_alpha(0.55) : Theme.border;
    animate background, border-color {
        duration: Theme.quick;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: root.show_dot ? Theme.sp_3 : Theme.sp_4;
        padding-right: Theme.sp_4;
        spacing: Theme.sp_2;

        if root.show_dot : Dot {
            tint: root.tint;
            diameter: 8px;
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: Theme.fs_label;
                font-weight: 500;
                color: root.selected ? Theme.text : Theme.text_muted;
            }
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ---------------------------------------------------------------------- rows

export component HabitRow inherits Rectangle {
    in property <HabitItem> item;
    in property <bool> show_check: true;
    in property <string> subtitle: root.item.streak_label;
    /// When false the row body is inert and only the checkbox reacts.
    in property <bool> selectable: true;
    in property <bool> show_due: true;
    callback toggled();
    callback picked();

    height: 60px;
    border-radius: Theme.r_md;
    background: (root.selectable && touch.pressed) ? Theme.surface_alt : transparent;
    animate background {
        duration: Theme.quick;
        easing: ease-out;
    }

    // Declared first so the checkbox below sits on top of it and wins the tap.
    touch := TouchArea {
        enabled: root.selectable;
        clicked => {
            root.picked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.sp_4;
        padding-right: Theme.sp_1;
        spacing: Theme.sp_3;

        Dot {
            tint: root.item.color;
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: root.item.name;
                font-size: Theme.fs_body;
                font-weight: 500;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
                overflow: elide;
            }
        }

        if root.show_due && root.item.due : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                border-radius: 10px;
                background: root.item.color.with_alpha(0.18);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "DUE";
                            font-size: 9px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: root.item.color;
                        }
                    }
                }
            }
        }

        if root.show_check : CheckButton {
            checked: root.item.done_today;
            tint: root.item.color;
            clicked => {
                root.toggled();
            }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <color> tint;
    callback toggled(on: bool);

    width: 46px;
    height: 28px;
    border-radius: 14px;
    background: root.on ? root.tint : Theme.surface_alt;
    border-width: 1px;
    border-color: root.on ? root.tint : Theme.border;
    animate background, border-color {
        duration: Theme.quick;
        easing: ease-out;
    }

    Rectangle {
        width: 22px;
        height: 22px;
        y: 2px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        border-radius: 11px;
        background: root.on ? #09090B : Theme.text_faint;
        animate x, background {
            duration: Theme.quick;
            easing: ease-out;
        }
    }

    TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
}

component StepArrow inherits Rectangle {
    in property <string> glyph;
    callback clicked();

    width: 34px;
    border-radius: Theme.r_sm;
    background: touch.pressed ? Theme.surface : transparent;
    animate background {
        duration: Theme.quick;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.glyph;
            font-size: Theme.fs_title;
            font-weight: 500;
            color: Theme.text_muted;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Stepper inherits Rectangle {
    in property <string> value;
    callback step(delta: int);

    height: 38px;
    border-radius: Theme.r_md;
    background: Theme.surface_alt;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 2px;

        StepArrow {
            glyph: "-";
            clicked => {
                root.step(-1);
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.value;
                font-size: Theme.fs_body;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                min-width: 30px;
            }
        }

        StepArrow {
            glyph: "+";
            clicked => {
                root.step(1);
            }
        }
    }
}

export component DayToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <color> tint;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: root.on ? root.tint.with_alpha(0.18) : Theme.surface_alt;
    border-width: 1px;
    border-color: root.on ? root.tint.with_alpha(0.6) : Theme.border;
    animate background, border-color {
        duration: Theme.quick;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: Theme.fs_caption;
            font-weight: root.on ? 700 : 500;
            color: root.on ? Theme.text : Theme.text_faint;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback picked(index: int);

    height: 38px;
    border-radius: Theme.r_md;
    background: Theme.surface_alt;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for label[i] in root.options : Rectangle {
            border-radius: Theme.r_md - 3px;
            background: i == root.selected ? Theme.surface : transparent;
            border-width: i == root.selected ? 1px : 0px;
            border-color: Theme.border;
            animate background {
                duration: Theme.quick;
                easing: ease-out;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: label;
                    font-size: Theme.fs_label;
                    font-weight: i == root.selected ? 600 : 500;
                    color: i == root.selected ? Theme.text : Theme.text_muted;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

export component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.sp_2;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.label;
            font-size: Theme.fs_body;
            font-weight: 500;
            color: Theme.text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.fs_caption;
            color: Theme.text_faint;
            wrap: word-wrap;
        }
    }

    @children
}

// ------------------------------------------------------------------ tab icons

component IconToday inherits Rectangle {
    in property <color> tint;
    width: 18px;
    height: 18px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 3 9.5 L 7 13.5 L 15 4.5";
        stroke: root.tint;
        stroke-width: 2px;
    }
}

component IconGraph inherits Rectangle {
    in property <color> tint;
    width: 18px;
    height: 18px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        for row in [0, 1, 2] : HorizontalLayout {
            alignment: center;
            spacing: 2px;
            for col in [0, 1, 2] : Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 1px;
                background: root.tint;
                opacity: (row + col) < 1 ? 0.3 : ((row + col) < 3 ? 0.65 : 1.0);
            }
        }
    }
}

component IconHabits inherits Rectangle {
    in property <color> tint;
    width: 18px;
    height: 18px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        for row in [0, 1, 2] : HorizontalLayout {
            spacing: 4px;
            Dot {
                tint: root.tint;
                diameter: 4px;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 2px;
                    border-radius: 1px;
                    background: root.tint;
                    opacity: 0.55;
                }
            }
        }
    }
}

component IconSettings inherits Rectangle {
    in property <color> tint;
    width: 18px;
    height: 18px;

    // Two slider tracks, knob sitting on the line - distinct from the habits
    // icon, whose dots lead each row.
    Rectangle {
        x: 1px;
        y: 5px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
        opacity: 0.55;
    }
    Rectangle {
        x: 4px;
        y: 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.tint;
    }
    Rectangle {
        x: 1px;
        y: 11px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
        opacity: 0.55;
    }
    Rectangle {
        x: 9px;
        y: 9px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.tint;
    }
}

export component TabBar inherits Rectangle {
    in property <color> tint;
    in-out property <int> current;
    /// Count shown on the Today tab; hidden when zero.
    in property <int> badge;
    /// Gesture-bar height on Android; zero on desktop.
    in property <length> bottom_inset;

    property <[string]> labels: [ "Graph", "Today", "Habits", "Settings" ];

    height: 62px + root.bottom_inset;
    background: Theme.bg;

    // Hairline divider with the active indicator riding on top of it.
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    Rectangle {
        y: 0;
        height: 2px;
        width: 26px;
        border-radius: 1px;
        background: root.tint;
        x: (root.width / root.labels.length) * root.current
            + (root.width / root.labels.length - self.width) / 2;
        animate x {
            duration: Theme.quick;
            easing: ease-out;
        }
    }

    HorizontalLayout {
        padding-top: Theme.sp_2;
        padding-bottom: root.bottom_inset;

        for tab[i] in root.labels : Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 5px;

                HorizontalLayout {
                    alignment: center;
                    if i == 0 : IconGraph {
                        tint: i == root.current ? root.tint : Theme.text_faint;
                    }
                    if i == 1 : IconToday {
                        tint: i == root.current ? root.tint : Theme.text_faint;
                    }
                    if i == 2 : IconHabits {
                        tint: i == root.current ? root.tint : Theme.text_faint;
                    }
                    if i == 3 : IconSettings {
                        tint: i == root.current ? root.tint : Theme.text_faint;
                    }

                    if i == 1 && root.badge > 0 : Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.tint;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.badge;
                                font-size: 9px;
                                font-weight: 700;
                                color: #09090B;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: tab;
                    font-size: Theme.fs_caption;
                    font-weight: i == root.current ? 700 : 500;
                    letter-spacing: 0.4px;
                    color: i == root.current ? Theme.text : Theme.text_faint;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    root.current = i;
                }
            }
        }
    }
}
