import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HabitGraph, HabitItem, HabitStats, ReminderView } from "types.slint";
import {
    Card, SectionLabel, StatBlock, Dot, HabitMark, HabitRow,
    SwatchGrid, EmojiGrid, TextField, GhostButton, Segmented, SettingRow,
    ReminderEditor,
} from "components.slint";
import { ContributionGraph, GraphKey } from "graph.slint";

// Landing page: totals, then one self-contained block per habit.
export component GraphPage inherits VerticalLayout {
    in property <[HabitGraph]> graphs;
    in property <HabitStats> totals;
    in property <color> accent;
    in property <string> summary_label;
    in property <[string]> weekday_labels;

    spacing: Theme.sp_4;

    Card {
        VerticalLayout {
            padding: Theme.sp_5;
            spacing: Theme.sp_3;

            HorizontalLayout {
                StatBlock {
                    value: root.totals.streak;
                    caption: "STREAK";
                    tint: root.accent;
                }
                StatBlock {
                    value: root.totals.rate;
                    caption: "RATE";
                }
                StatBlock {
                    value: root.totals.done;
                    caption: "DONE";
                }
            }

            Text {
                text: root.summary_label;
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
                horizontal-alignment: center;
                overflow: elide;
            }

            GraphKey {
                tint: root.accent;
            }
        }
    }

    for graph in root.graphs : Card {
        VerticalLayout {
            padding: Theme.sp_4;
            spacing: Theme.sp_3;

            HorizontalLayout {
                spacing: Theme.sp_2;
                alignment: start;

                HabitMark {
                    emoji: graph.emoji;
                    tint: graph.color;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: graph.name;
                        font-size: Theme.fs_body;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
            }

            ContributionGraph {
                weeks: graph.weeks;
                tint: graph.color;
                weekday_labels: root.weekday_labels;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Text {
                text: graph.summary;
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
                overflow: elide;
            }
        }
    }

    if root.graphs.length == 0 : Card {
        VerticalLayout {
            padding: Theme.sp_6;
            spacing: Theme.sp_2;

            Text {
                text: "Nothing tracked yet";
                font-size: Theme.fs_body;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Add a habit on the Habits tab and its graph appears here.";
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

export component TodayPage inherits VerticalLayout {
    in property <[HabitItem]> habits;
    in property <color> accent;
    in property <int> due_count;
    in property <string> due_label;

    callback toggle(id: string);

    spacing: Theme.sp_4;

    if root.due_count > 0 : Card {
        background: root.accent.with_alpha(0.12);
        border-color: root.accent.with_alpha(0.4);

        HorizontalLayout {
            padding: Theme.sp_4;
            spacing: Theme.sp_3;
            alignment: start;

            Dot {
                tint: root.accent;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.due_label;
                    font-size: Theme.fs_label;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
            }
        }
    }

    SectionLabel {
        text: "TODAY";
    }

    if root.habits.length > 0 : Card {
        VerticalLayout {
            padding: Theme.sp_2;
            spacing: 2px;

            for habit in root.habits : HabitRow {
                item: habit;
                selectable: false;
                toggled => {
                    root.toggle(habit.id);
                }
            }
        }
    }

    // Creating habits lives on the Habits tab, so point there rather than
    // leaving an empty card with no way forward.
    if root.habits.length == 0 : Card {
        VerticalLayout {
            padding: Theme.sp_6;
            spacing: Theme.sp_2;

            Text {
                text: "Nothing to check off";
                font-size: Theme.fs_body;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Add a habit on the Habits tab and it shows up here each day.";
                font-size: Theme.fs_caption;
                color: Theme.text_faint;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

export component HabitsPage inherits VerticalLayout {
    in property <[HabitItem]> habits;
    in property <[color]> palette;
    in property <[string]> emoji_palette;
    in property <[string]> day_labels;
    in-out property <string> new_habit_name;
    in-out property <int> new_color_index;
    /// -1 means no emoji.
    in-out property <int> new_emoji_index;
    /// The add form's reminder, saved with the habit when it is added.
    in property <ReminderView> new_reminder;

    callback add();
    /// Rust resets the whole form, draft reminder included.
    callback cancel_add();
    callback recolor(id: string, index: int);
    callback set_emoji(id: string, index: int);
    callback delete(id: string);
    callback reminder_toggled(id: string, on: bool);
    callback reminder_shift(id: string, hours: int, minutes: int);
    callback reminder_day_toggled(id: string, day: int);
    callback reminder_kind_picked(id: string, kind: int);
    callback reminder_interval_shift(id: string, delta: int);
    callback reminder_month_day_shift(id: string, delta: int);
    callback reminder_date_shift(id: string, days: int, months: int);

    property <string> editing_id: "";
    property <bool> adding: false;
    /// Set by the first tap on Delete; only one habit is open at a time.
    property <bool> confirm_delete: false;

    spacing: Theme.sp_4;

    SectionLabel {
        text: "ALL HABITS";
    }

    Card {
        VerticalLayout {
            padding: Theme.sp_2;
            spacing: 2px;

            for habit in root.habits : VerticalLayout {
                spacing: 0px;

                HabitRow {
                    item: habit;
                    subtitle: habit.created_label;
                    show_check: false;
                    show_due: false;
                    picked => {
                        root.editing_id = root.editing_id == habit.id ? "" : habit.id;
                        root.confirm_delete = false;
                    }
                }

                if root.editing_id == habit.id : VerticalLayout {
                    padding-left: Theme.sp_4;
                    padding-right: Theme.sp_2;
                    padding-bottom: Theme.sp_3;
                    spacing: Theme.sp_3;

                    SwatchGrid {
                        tones: root.palette;
                        selected_index: habit.color_index;
                        columns: 5;
                        picked(index) => {
                            root.recolor(habit.id, index);
                        }
                    }

                    EmojiGrid {
                        emojis: root.emoji_palette;
                        selected_emoji: habit.emoji;
                        columns: 6;
                        picked(index) => {
                            root.set_emoji(habit.id, index);
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    ReminderEditor {
                        reminder: habit.reminder;
                        tint: habit.color;
                        day_labels: root.day_labels;
                        toggled(on) => {
                            root.reminder_toggled(habit.id, on);
                        }
                        shift(hours, minutes) => {
                            root.reminder_shift(habit.id, hours, minutes);
                        }
                        day_toggled(day) => {
                            root.reminder_day_toggled(habit.id, day);
                        }
                        kind_picked(kind) => {
                            root.reminder_kind_picked(habit.id, kind);
                        }
                        interval_shift(delta) => {
                            root.reminder_interval_shift(habit.id, delta);
                        }
                        month_day_shift(delta) => {
                            root.reminder_month_day_shift(habit.id, delta);
                        }
                        date_shift(days, months) => {
                            root.reminder_date_shift(habit.id, days, months);
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Deleting erases the habit's history, so it takes a
                    // second tap.
                    if !root.confirm_delete : HorizontalLayout {
                        alignment: start;
                        GhostButton {
                            label: "Delete";
                            tint: #F87171;
                            clicked => {
                                root.confirm_delete = true;
                            }
                        }
                    }

                    if root.confirm_delete : VerticalLayout {
                        spacing: Theme.sp_2;

                        Text {
                            text: "Delete this habit and all of its history? This can't be undone.";
                            font-size: Theme.fs_caption;
                            color: Theme.text_muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Theme.sp_2;
                            GhostButton {
                                label: "Cancel";
                                tint: Theme.text_faint;
                                clicked => {
                                    root.confirm_delete = false;
                                }
                            }
                            GhostButton {
                                label: "Delete";
                                tint: #F87171;
                                clicked => {
                                    root.delete(habit.id);
                                    root.editing_id = "";
                                    root.confirm_delete = false;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            if !root.adding : GhostButton {
                label: "+   Add a habit";
                tint: Theme.text_muted;
                clicked => {
                    root.adding = true;
                }
            }

            if root.adding : VerticalLayout {
                padding: Theme.sp_2;
                spacing: Theme.sp_3;

                TextField {
                    placeholder: "Habit name";
                    text <=> root.new_habit_name;
                    accepted => {
                        root.add();
                        root.adding = false;
                    }
                }

                SwatchGrid {
                    tones: root.palette;
                    selected_index: root.new_color_index;
                    columns: 5;
                    picked(index) => {
                        root.new_color_index = index;
                    }
                }

                EmojiGrid {
                    emojis: root.emoji_palette;
                    selected_emoji: root.new_emoji_index == -1
                        ? ""
                        : root.emoji_palette[root.new_emoji_index];
                    columns: 6;
                    picked(index) => {
                        root.new_emoji_index = index;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // An empty id addresses the draft rather than a saved habit.
                ReminderEditor {
                    reminder: root.new_reminder;
                    tint: root.palette[root.new_color_index];
                    day_labels: root.day_labels;
                    toggled(on) => {
                        root.reminder_toggled("", on);
                    }
                    shift(hours, minutes) => {
                        root.reminder_shift("", hours, minutes);
                    }
                    day_toggled(day) => {
                        root.reminder_day_toggled("", day);
                    }
                    kind_picked(kind) => {
                        root.reminder_kind_picked("", kind);
                    }
                    interval_shift(delta) => {
                        root.reminder_interval_shift("", delta);
                    }
                    month_day_shift(delta) => {
                        root.reminder_month_day_shift("", delta);
                    }
                    date_shift(days, months) => {
                        root.reminder_date_shift("", days, months);
                    }
                }

                HorizontalLayout {
                    spacing: Theme.sp_2;
                    GhostButton {
                        label: "Cancel";
                        tint: Theme.text_faint;
                        clicked => {
                            root.adding = false;
                            root.cancel_add();
                        }
                    }
                    GhostButton {
                        label: "Add habit";
                        tint: root.palette[root.new_color_index];
                        clicked => {
                            root.add();
                            root.adding = false;
                        }
                    }
                }
            }
        }
    }

    Text {
        text: "Tap a habit to change its look, set a schedule, or delete it.";
        font-size: Theme.fs_caption;
        color: Theme.text_faint;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component SettingsPage inherits VerticalLayout {
    in property <[color]> palette;
    in property <color> accent;
    in property <int> theme_mode;
    /// -1 follows the first habit's colour.
    in property <int> accent_index;
    in property <int> graph_weeks;
    in property <bool> week_start_sunday;

    callback theme_mode_picked(index: int);
    callback accent_picked(index: int);
    callback graph_weeks_picked(weeks: int);
    callback week_start_picked(sunday: bool);

    spacing: Theme.sp_4;

    SectionLabel {
        text: "APPEARANCE";
    }

    Card {
        VerticalLayout {
            padding: Theme.sp_4;
            spacing: Theme.sp_5;

            SettingRow {
                label: "Theme";
                hint: "System follows your OS appearance.";
                Segmented {
                    options: [ "Dark", "Light", "System" ];
                    selected: root.theme_mode;
                    picked(index) => {
                        root.theme_mode_picked(index);
                    }
                }
            }

            SettingRow {
                label: "Accent";
                hint: "Used for the tab indicator and totals. Auto follows your first habit.";

                // Wrapped: nine swatches in one row needed 343px and the card
                // only ever offers the window width minus 80px.
                SwatchGrid {
                    tones: root.palette;
                    selected_index: root.accent_index;
                    show_auto: true;
                    auto_tone: root.accent_index == -1 ? root.accent : Theme.surface_alt;
                    columns: 5;
                    picked(index) => {
                        root.accent_picked(index);
                    }
                }
            }
        }
    }

    SectionLabel {
        text: "GRAPH";
    }

    Card {
        VerticalLayout {
            padding: Theme.sp_4;
            spacing: Theme.sp_5;

            SettingRow {
                label: "History shown";
                hint: "Longer ranges pack the cells tighter.";
                Segmented {
                    options: [ "12 weeks", "17 weeks", "26 weeks" ];
                    selected: root.graph_weeks == 12 ? 0 : (root.graph_weeks == 26 ? 2 : 1);
                    picked(index) => {
                        root.graph_weeks_picked(index == 0 ? 12 : (index == 2 ? 26 : 17));
                    }
                }
            }

            SettingRow {
                label: "Week starts on";
                hint: "";
                Segmented {
                    options: [ "Monday", "Sunday" ];
                    selected: root.week_start_sunday ? 1 : 0;
                    picked(index) => {
                        root.week_start_picked(index == 1);
                    }
                }
            }
        }
    }

    Text {
        text: "All data stays on this device.";
        font-size: Theme.fs_caption;
        color: Theme.text_faint;
        horizontal-alignment: center;
    }
}
