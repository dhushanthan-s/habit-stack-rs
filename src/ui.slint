import { ScrollView } from "std-widgets.slint";
import { Theme } from "ui/theme.slint";
import { GraphDay, GraphWeek, HabitGraph, HabitItem, HabitStats, ReminderView } from "ui/types.slint";
import { TabBar } from "ui/components.slint";
import { TodayPage, GraphPage, HabitsPage, SettingsPage } from "ui/pages.slint";

// Re-exported so slint-build generates the matching Rust types.
export { GraphDay, GraphWeek, HabitGraph, HabitItem, HabitStats, ReminderView, Theme }

export component AppWindow inherits Window {
    title: "Habit Stack";
    background: Theme.bg;
    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 320px;
    min-height: 520px;

    in property <[HabitGraph]> habit_graphs;
    in property <HabitStats> totals;
    in property <string> summary_label;
    in property <[HabitItem]> habits;
    in property <[color]> palette;
    in property <[string]> emoji_palette;
    in property <color> accent;
    in property <string> today_label;
    in property <[string]> weekday_labels;
    in property <[string]> day_labels;
    in property <int> due_count;
    in property <string> due_label;
    // Supplied by the Android activity; zero on desktop.
    in property <length> top_inset;
    in property <length> bottom_inset;
    in property <int> theme_mode;
    in property <int> accent_index;
    in property <int> graph_weeks;
    in property <bool> week_start_sunday;

    in-out property <string> new_habit_name;
    in-out property <int> new_color_index;
    /// -1 means no emoji.
    in-out property <int> new_emoji_index;
    in property <ReminderView> new_reminder;
    in-out property <int> active_tab;

    callback toggle_today(id: string);
    callback add_habit_requested(name: string, color_index: int, emoji_index: int);
    callback add_cancelled();
    callback set_habit_color(id: string, color_index: int);
    callback set_habit_emoji(id: string, emoji_index: int);
    callback delete_habit(id: string);
    // Reminder callbacks take an empty id for the add form's draft.
    callback reminder_toggled(id: string, on: bool);
    callback reminder_shift(id: string, hours: int, minutes: int);
    callback reminder_day_toggled(id: string, day: int);
    callback reminder_kind_picked(id: string, kind: int);
    callback reminder_interval_shift(id: string, delta: int);
    callback reminder_month_day_shift(id: string, delta: int);
    callback reminder_date_shift(id: string, days: int, months: int);
    callback theme_mode_picked(index: int);
    callback accent_picked(index: int);
    callback graph_weeks_picked(weeks: int);
    callback week_start_picked(sunday: bool);

    VerticalLayout {
        // ------------------------------------------------------------ header
        VerticalLayout {
            padding-left: Theme.sp_5;
            padding-right: Theme.sp_4;
            padding-top: Theme.sp_4 + root.top_inset;
            padding-bottom: Theme.sp_4;
            spacing: 2px;

            Text {
                text: "Habit Stack";
                font-size: Theme.fs_title;
                font-weight: 700;
                letter-spacing: -0.2px;
                color: Theme.text;
            }

            Text {
                text: root.today_label;
                font-size: Theme.fs_label;
                color: Theme.text_muted;
            }
        }

        // ------------------------------------------------------------- pages
        ScrollView {
            // Pin content to the viewport width: these pages scroll vertically
            // only, and the graph derives its cell size from this width.
            viewport-width: self.visible-width;

            VerticalLayout {
                padding-left: Theme.sp_5;
                padding-right: Theme.sp_5;
                padding-bottom: Theme.sp_5;

                if root.active_tab == 0 : GraphPage {
                    graphs: root.habit_graphs;
                    totals: root.totals;
                    accent: root.accent;
                    summary_label: root.summary_label;
                    weekday_labels: root.weekday_labels;
                }

                if root.active_tab == 1 : TodayPage {
                    habits: root.habits;
                    accent: root.accent;
                    due_count: root.due_count;
                    due_label: root.due_label;
                    toggle(id) => {
                        root.toggle_today(id);
                    }
                }

                if root.active_tab == 2 : HabitsPage {
                    habits: root.habits;
                    palette: root.palette;
                    emoji_palette: root.emoji_palette;
                    day_labels: root.day_labels;
                    new_habit_name <=> root.new_habit_name;
                    new_color_index <=> root.new_color_index;
                    new_emoji_index <=> root.new_emoji_index;
                    new_reminder: root.new_reminder;
                    add => {
                        root.add_habit_requested(
                            root.new_habit_name, root.new_color_index, root.new_emoji_index);
                    }
                    cancel_add => {
                        root.add_cancelled();
                    }
                    recolor(id, index) => {
                        root.set_habit_color(id, index);
                    }
                    set_emoji(id, index) => {
                        root.set_habit_emoji(id, index);
                    }
                    delete(id) => {
                        root.delete_habit(id);
                    }
                    reminder_toggled(id, on) => {
                        root.reminder_toggled(id, on);
                    }
                    reminder_shift(id, hours, minutes) => {
                        root.reminder_shift(id, hours, minutes);
                    }
                    reminder_day_toggled(id, day) => {
                        root.reminder_day_toggled(id, day);
                    }
                    reminder_kind_picked(id, kind) => {
                        root.reminder_kind_picked(id, kind);
                    }
                    reminder_interval_shift(id, delta) => {
                        root.reminder_interval_shift(id, delta);
                    }
                    reminder_month_day_shift(id, delta) => {
                        root.reminder_month_day_shift(id, delta);
                    }
                    reminder_date_shift(id, days, months) => {
                        root.reminder_date_shift(id, days, months);
                    }
                }

                if root.active_tab == 3 : SettingsPage {
                    palette: root.palette;
                    accent: root.accent;
                    theme_mode: root.theme_mode;
                    accent_index: root.accent_index;
                    graph_weeks: root.graph_weeks;
                    week_start_sunday: root.week_start_sunday;
                    theme_mode_picked(index) => {
                        root.theme_mode_picked(index);
                    }
                    accent_picked(index) => {
                        root.accent_picked(index);
                    }
                    graph_weeks_picked(weeks) => {
                        root.graph_weeks_picked(weeks);
                    }
                    week_start_picked(sunday) => {
                        root.week_start_picked(sunday);
                    }
                }
            }
        }

        // ----------------------------------------------------------- tab bar
        TabBar {
            tint: root.accent;
            current <=> root.active_tab;
            badge: root.due_count;
            bottom_inset: root.bottom_inset;
        }
    }
}
