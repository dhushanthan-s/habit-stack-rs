import { ScrollView } from "std-widgets.slint";
import { Theme } from "ui/theme.slint";
import { GraphDay, GraphWeek, HabitGraph, HabitItem, HabitStats } from "ui/types.slint";
import { TabBar } from "ui/components.slint";
import { TodayPage, GraphPage, HabitsPage } from "ui/pages.slint";

// Re-exported so slint-build generates the matching Rust types.
export { GraphDay, GraphWeek, HabitGraph, HabitItem, HabitStats, Theme }

// Sun in light mode (a ring), crescent moon in dark (a disc with a bite).
component ThemeToggle inherits Rectangle {
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: Theme.r_md;
    background: touch.pressed ? Theme.surface_alt : transparent;
    animate background {
        duration: Theme.quick;
        easing: ease-out;
    }

    Rectangle {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.dark ? Theme.text_muted : transparent;
        border-width: Theme.dark ? 0px : 2px;
        border-color: Theme.text_muted;

        if Theme.dark : Rectangle {
            width: 14px;
            height: 14px;
            x: 6px;
            y: -4px;
            border-radius: self.width / 2;
            background: Theme.bg;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "Habit Stack";
    background: Theme.bg;
    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 320px;
    min-height: 520px;

    in property <[HabitGraph]> habit_graphs;
    in property <HabitStats> totals;
    in property <string> summary_label;
    in property <[HabitItem]> habits;
    in property <[color]> palette;
    in property <color> accent;
    in property <string> today_label;

    in-out property <string> new_habit_name;
    in-out property <int> new_color_index;
    in-out property <int> active_tab;

    callback toggle_today(id: string);
    callback add_habit_requested(name: string, color_index: int);
    callback set_habit_color(id: string, color_index: int);
    callback archive_habit(id: string);
    callback theme_changed(dark: bool);

    VerticalLayout {
        // ------------------------------------------------------------ header
        VerticalLayout {
            padding-left: Theme.sp_5;
            padding-right: Theme.sp_4;
            padding-top: Theme.sp_4;
            padding-bottom: Theme.sp_4;
            spacing: 2px;

            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Habit Stack";
                        font-size: Theme.fs_title;
                        font-weight: 700;
                        letter-spacing: -0.2px;
                        color: Theme.text;
                    }
                }

                ThemeToggle {
                    clicked => {
                        Theme.dark = !Theme.dark;
                        root.theme_changed(Theme.dark);
                    }
                }
            }

            Text {
                text: root.today_label;
                font-size: Theme.fs_label;
                color: Theme.text_muted;
            }
        }

        // ------------------------------------------------------------- pages
        ScrollView {
            // Pin content to the viewport width: these pages scroll vertically
            // only, and the graph derives its cell size from this width.
            viewport-width: self.visible-width;

            VerticalLayout {
                padding-left: Theme.sp_5;
                padding-right: Theme.sp_5;
                padding-bottom: Theme.sp_5;

                if root.active_tab == 0 : GraphPage {
                    graphs: root.habit_graphs;
                    totals: root.totals;
                    accent: root.accent;
                    summary_label: root.summary_label;
                }

                if root.active_tab == 1 : TodayPage {
                    habits: root.habits;
                    palette: root.palette;
                    new_habit_name <=> root.new_habit_name;
                    new_color_index <=> root.new_color_index;
                    toggle(id) => {
                        root.toggle_today(id);
                    }
                    add => {
                        root.add_habit_requested(root.new_habit_name, root.new_color_index);
                    }
                }

                if root.active_tab == 2 : HabitsPage {
                    habits: root.habits;
                    palette: root.palette;
                    recolor(id, index) => {
                        root.set_habit_color(id, index);
                    }
                    archive(id) => {
                        root.archive_habit(id);
                    }
                }
            }
        }

        // ----------------------------------------------------------- tab bar
        TabBar {
            tint: root.accent;
            current <=> root.active_tab;
        }
    }
}
