<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 35 forces edge-to-edge for targetSdk 35, which would draw the app's
         header underneath the status bar. Slint has no inset API in 1.15, so opt
         out until insets can be plumbed through to the markup properly. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#09090B</item>
        <item name="android:navigationBarColor">#09090B</item>
        <item name="android:windowBackground">#09090B</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
